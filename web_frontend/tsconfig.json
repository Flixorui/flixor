{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/routes/*": ["src/routes/*"],
      "@/services/*": ["src/services/*"],
      "@/state/*": ["src/state/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/version": ["src/version.ts"],
      "@/stremio": ["src/stremio/index.ts"],
      "@/stremio/*": ["src/stremio/*"],
      "@/player/*": ["src/player/*"]
    }
  },
  "include": ["src"]
}

