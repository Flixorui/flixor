{
  "expo": {
    "name": "Popcorn",
    "slug": "popcorn-mobile",
    "scheme": "popcorn",
    "version": "0.1.0",
    "runtimeVersion": "0.1.0",
    "orientation": "default",
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 30000,
      "url": "https://ota.thepopcorn.fr/api/manifest"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.thepopcorn.mobile",
      "icon": "./assets/icons/ios-light.png",
      "jsEngine": "hermes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "fr.thepopcorn.mobile",
      "usesCleartextTraffic": true,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "ndkVersion": "27.1.12297006"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/go-noto-current-regular.ttf"]
        }
      ],
      "./plugins/withKSPlayer",
      "./plugins/withMPViOS",
      "./plugins/withMPVPlayer"
    ]
  }
}
